# Copy to .env and fill in locally. NEVER commit real keys (spec 0.6, 11).
# Each owner edits only their own section (spec 18.6 rule 5). Flags default to the in-memory fakes.

# ============================== P1 — Spine ==============================
NODE_ENV=development
LOG_LEVEL=info
# memory = in-process stores (simulator/tests) | postgres = core.* tables
RUNTIME_STORE=memory
# postgres://campus_app_user:<APP_DB_PASSWORD>@localhost:5432/campus
#   or pglite://./.data/pglite for local Postgres without Docker
DATABASE_URL=
# Owner role used only by `pnpm db:migrate` (defaults to DATABASE_URL)
# postgres://campus_owner:<POSTGRES_PASSWORD>@localhost:5432/campus
DATABASE_URL_ADMIN=
REDIS_URL=redis://localhost:6379
# docker-compose only (local dev passwords; pick your own)
POSTGRES_USER=campus_owner
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
GATEWAY_DB_PASSWORD=

USE_REAL_MODEL=false
# anthropic | gemini
MODEL_PROVIDER=anthropic
# The key for MODEL_PROVIDER (Anthropic API key, or Gemini API key from Google AI Studio)
MODEL_API_KEY=
# Optional; defaults to claude-opus-5-5 (anthropic) or gemini-3.8-flash (gemini)
MODEL_NAME=
# low | medium | high | xhigh | max  (Gemini uses low/medium/high; xhigh/max → high)
MODEL_EFFORT=medium
MODEL_STRUCTURED_OUTPUT=true

AGENT_DISPLAY_NAME=Campus Agent
AGENT_INVOCATION_NAMES=@agent,agent,campus agent

TURN_MAX_MODEL_STEPS=4
TURN_MAX_TOOL_CALLS=6
TURN_TIMEOUT_MS=90000
MODEL_CALL_TIMEOUT_MS=45000
TOOL_CALL_TIMEOUT_MS=15000
TURN_MAX_TOKENS=150000
MODEL_MAX_OUTPUT_TOKENS=4096
RATE_LIMIT_USER_MODEL_CALLS_PER_10MIN=40
RATE_LIMIT_CONVERSATION_MODEL_CALLS_PER_10MIN=80

QUEUE_MAX_ATTEMPTS=5
WORKER_POLL_INTERVAL_MS=250
WORKER_CONCURRENCY=4
RUN_WORKER_IN_PROCESS=false
API_PORT=3000
TRACE_API_ENABLED=true
# Required when NODE_ENV=production and the trace API is enabled
TRACE_API_TOKEN=
GROUP_MEAL_OPTIONS_TOOL=dining__search_options

# ============================== P2 — Front door ==============================
USE_REAL_MESSAGING=false
USE_REAL_IDENTITY=false
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_VERIFY_SERVICE_SID=
SENDBLUE_VERIFY_WEBHOOK_SECRET=
APP_ORIGIN=http://localhost:3001
NUDGE_INTERVAL_HOURS=6

# ============================== P3 — Memory ==============================
USE_REAL_MEMORY=false
SUPERMEMORY_API_KEY=

# ============================== P4 — Hands ==============================
USE_REAL_TOOLS=false
# postgres://campus_gateway_user:<GATEWAY_DB_PASSWORD>@localhost:5432/campus
DATABASE_URL_VAULT=
VAULT_KEY_ID=
# dev only; use a KMS/secret store otherwise
VAULT_MASTER_KEY=
COMPOSIO_API_KEY=
OAUTH_REDIRECT_BASE=http://localhost:3000/oauth/callback
SPENDING_CEILING_MINOR=3000
