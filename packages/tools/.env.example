# P4-owned example only. P1 copies these into its config loader/.env P4 section.
# No defaults for secrets; generate independent random 32-byte base64 keys.
USE_REAL_TOOLS=false
DATABASE_URL=
DATABASE_URL_VAULT=
P4_APP_DB_ROLE=
P4_GATEWAY_DB_ROLE=
VAULT_KEY_ID=1
VAULT_MASTER_KEY=
# Old keys remain available during rotation:
VAULT_MASTER_KEY_V1=
APPROVAL_HASH_KEY=
OAUTH_REDIRECT_BASE=https://your-approved-host.example
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
COMPOSIO_API_KEY=
COMPOSIO_CALENDAR_AUTH_CONFIG_ID=
# Exact toolkit version obtained from the Composio dashboard/API; never 'latest'.
COMPOSIO_CALENDAR_VERSION=
