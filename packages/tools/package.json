{
  "name": "@campus/tools",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "test": "node --test tests/*.test.ts ../approvals/tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write src tests scripts *.json ../approvals/src ../approvals/tests ../approvals/*.json",
    "format:check": "prettier --check src tests scripts *.json ../approvals/src ../approvals/tests ../approvals/*.json",
    "lint": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "@composio/core": "0.27.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
